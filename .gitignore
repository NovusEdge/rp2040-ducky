# C / Pico SDK build output
build/
*.uf2
*.elf
*.bin
*.hex

# The CircuitPython runtime image ships in the repo; the *.uf2 rule above hides it.
!runtimes/circuitpython/firmware/*.uf2

# Python / uv
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
